# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key

# Ignore SimpleCov output if any spec adds coverage tracking.
/coverage

# Ignore Node modules in case the host adds esbuild / tailwind later.
/node_modules

# Ignore stray sqlite files (the host is on Postgres but rails new
# leaves a couple of *.sqlite3 references; defensive).
/db/*.sqlite3*

# Ignore pry/byebug history to keep secrets-in-history risk low.
/.byebug_history
/.pry_history

